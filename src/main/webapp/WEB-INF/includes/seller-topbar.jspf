<%@ page pageEncoding="UTF-8" %>
<%
    String __topCtx = request.getContextPath();
    String __topForward = (String) request.getAttribute("javax.servlet.forward.request_uri");
    String __topUri = __topForward != null ? __topForward : request.getRequestURI();
    String __topAction = request.getParameter("action");
    String __topTitle = "工作台";
    if (__topUri.endsWith("/seller/sell")) {
        __topTitle = "代客售票";
    } else if (__topUri.endsWith("/book")) {
        __topTitle = "代客选座";
    } else if (__topUri.endsWith("/seller/orders")) {
        __topTitle = "销售订单";
    } else if (__topUri.endsWith("/seller/performance")) {
        __topTitle = "我的业绩";
    } else if (__topUri.endsWith("/seller/checkin")) {
        if ("records".equals(__topAction)) {
            __topTitle = "检票记录";
        } else if ("stats".equals(__topAction)) {
            __topTitle = "检票统计";
        } else {
            __topTitle = "检票";
        }
    }
%>
<header class="app-topbar">
    <a class="app-brand" href="<%= __topCtx %>/seller/home">
        <span class="brand-mark"><span class="ico ico-ferry" aria-hidden="true"></span></span>
        <span class="brand-name">码头售票系统</span>
        <span class="brand-sep">·</span>
        <span class="brand-page"><%= __topTitle %></span>
    </a>
    <div class="app-user">
        <span class="user-chip"><span class="ico ico-user" aria-hidden="true"></span>售票员：${sessionScope.userName}</span>
        <a class="app-logout" href="<%= __topCtx %>/logout"><span class="ico ico-logout" aria-hidden="true"></span>退出</a>
    </div>
</header>
